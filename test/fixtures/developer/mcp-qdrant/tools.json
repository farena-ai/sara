{
  "tools": [
    {
      "name": "qdrant-local-search",
      "description": "Search operator-seeded synthetic local vectors only. Numeric vectors; no embeddings or remote service.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collection",
          "vector",
          "limit"
        ],
        "properties": {
          "collection": {
            "type": "string",
            "enum": [
              "owned-vectors"
            ]
          },
          "vector": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    }
  ]
}
