{
  "name": "@farena-ai/sara-sdk",
  "version": "0.1.0",
  "description": "A small, dependency-free TypeScript client for Sara's HTTP API: device sign-in, streamed chat, approvals, files, the OpenAI-compatible /v1 and webhook verification.",
  "license": "MIT",
  "author": "farena-ai",
  "homepage": "https://github.com/farena-ai/sara/tree/main/packages/sara-sdk#readme",
  "bugs": {
    "url": "https://github.com/farena-ai/sara/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farena-ai/sara.git",
    "directory": "packages/sara-sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "examples/"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "keywords": [
    "sara",
    "ai",
    "companion",
    "assistant",
    "sdk",
    "client",
    "self-hosted",
    "openai-compatible",
    "webhooks"
  ]
}
