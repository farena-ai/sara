<?xml version="1.0" encoding="utf-8"?>
<!-- Setup and status on the watch: the server address, the pairing code, then what the tile shows. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="28dp" android:paddingBottom="36dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FFB9B0FF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFC46B" android:textSize="26sp" android:textStyle="bold" android:letterSpacing="0.08" android:visibility="gone" />
        <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/setup_intro" android:textColor="#FFFFFFFF" android:textSize="13sp" />
        <EditText android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:hint="@string/server_hint" android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true" android:textSize="13sp" />
        <Button android:id="@+id/go" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/get_code" />
        <Button android:id="@+id/talk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/talk" android:visibility="gone" />
        <Button android:id="@+id/forget" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/forget" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
