{
  "title": "Sara",
  "uid": "sara-overview",
  "description": "Sara's /metrics (EC3). Counts, timings and names only; no chat text.",
  "tags": [
    "sara"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(sara_build_info, job)",
        "refresh": 2,
        "label": "Job"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Replies per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(sara_turns_total{job=\"$job\"}[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Reply time (p50 / p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sara_turn_duration_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sara_turn_duration_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sara_turn_first_token_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "first word p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Model call p95 by model",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider, model) (rate(sara_model_call_duration_seconds_bucket{job=\"$job\"}[5m])))",
          "legendFormat": "{{provider}} {{model}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Model errors per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, model) (rate(sara_model_calls_total{job=\"$job\",outcome=\"error\"}[5m])) * 60",
          "legendFormat": "{{provider}} {{model}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokens per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(sara_model_tokens_total{job=\"$job\"}[5m])) * 60",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Estimated cost (last 24 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(sara_model_cost_usd_total{job=\"$job\"}[24h]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tool calls per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, outcome) (rate(sara_tool_calls_total{job=\"$job\"}[5m])) * 60",
          "legendFormat": "{{tool}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Approvals and errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sara_approvals_requested_total{job=\"$job\"}[15m])) * 60",
          "legendFormat": "asked"
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(sara_approvals_resolved_total{job=\"$job\"}[15m])) * 60",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "C",
          "expr": "sum by (source) (rate(sara_errors_total{job=\"$job\"}[15m])) * 60",
          "legendFormat": "errors: {{source}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queues",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, state) (sara_queue_items{job=\"$job\",state=~\"waiting|queued|running|attempted|outcome_unknown|failed\"})",
          "legendFormat": "{{queue}} {{state}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Tool servers and chat apps",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sara_mcp_server_up{job=\"$job\"}",
          "legendFormat": "MCP {{server}}"
        },
        {
          "refId": "B",
          "expr": "sara_bridge_connected{job=\"$job\"}",
          "legendFormat": "{{bridge}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Database size",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sara_database_bytes{job=\"$job\"}",
          "legendFormat": "database"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Newest backup age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 40,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sara_backup_age_seconds{job=\"$job\"}",
          "legendFormat": "backup"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sara_uptime_seconds{job=\"$job\"}",
          "legendFormat": "uptime"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Trace exports",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 40,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(sara_trace_exports_total{job=\"$job\"}[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
