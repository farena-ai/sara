node_modules/
# Runtime data: conversations, settings, encrypted secrets, master key, owner token.
data/
# Test fixtures that model a repository's own data folder are source, not runtime data.
!test/fixtures/**/data/
# Umbrel needs the app's empty bind-mount folder committed (sara/data/.gitkeep).
!packaging/umbrel/data/
*.db
*.db-journal
*.db-wal
*.db-shm
# Never commit credentials of any kind.
.env
.env.*
!.env.example
*.key
*.pem
.secrets/
outputs/
keystore.properties

# Phase 33: desktop app build output and downloaded SDKs
desktop/windows/build/
desktop/windows/third_party/
desktop/mac/build/

# Python caches (scripts/make-app-icons.py, integrations tests)
__pycache__/
*.pyc
