{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "dotenv",
        "json"
      ]
    },
    "text": {
      "type": "string",
      "maxLength": 100000,
      "minLength": 0
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "boolean",
              "url",
              "enum"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "min": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "max": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "minLength": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100,
              "minLength": 0
            },
            "maxItems": 20,
            "minItems": 1
          }
        },
        "required": [
          "name",
          "type",
          "required",
          "secret"
        ]
      },
      "maxItems": 100,
      "minItems": 1
    }
  },
  "required": [
    "format",
    "text",
    "rules"
  ]
}
